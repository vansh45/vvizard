    "\n",
    "def fib(n):\n",
    "    a, b = 0, 1\n",
    "    for _ in range(n):\n",
    "        yield a\n",
    "        a, b = b, a + b\n",
    "\n",
    "# print(list[int](fib(10)))\n",
    "print(sum(list[int](fib(11112025))))\n"
